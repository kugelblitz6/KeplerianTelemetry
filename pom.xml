<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>net.keplerian</groupId>
    <artifactId>telemetry</artifactId>
    <version>1.0.0</version>
    <name>KeplerianTelemetry</name>
    <description>Keplerian Telemetry WebSocket Server</description>

    <properties>
        <java.version>25</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn package -P bundle でJRE同梱の配布パッケージを生成 -->
        <profile>
            <id>bundle</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>assemble-bundle</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>powershell</executable>
                                    <arguments>
                                        <argument>-Command</argument>
                                        <argument>
                                            $dist = '${project.build.directory}\dist\KeplerianTelemetry';
                                            Remove-Item -Recurse -Force -ErrorAction SilentlyContinue $dist;
                                            New-Item -ItemType Directory -Force $dist | Out-Null;
                                            Copy-Item '${project.build.directory}\${project.build.finalName}.jar' $dist;
                                            Copy-Item -Recurse '${project.basedir}\LICENSES' $dist;
                                            Copy-Item -Recurse 'C:\Program Files\Eclipse Adoptium\jdk-25.0.3.9-hotspot' "$dist\runtime";
                                            Copy-Item '${project.basedir}\src\bundle\start.bat' $dist
                                        </argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
